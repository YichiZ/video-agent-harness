# Copy to .env and fill in. .env is gitignored; never commit keys.

# Claude. Optional: when unset, the agent falls back to your local Claude Code
# login (Claude subscription). Run `make doctor` to see which mode is active.
ANTHROPIC_API_KEY=

# ElevenLabs Scribe v2 (speech to text).
ELEVENLABS_API_KEY=

# Gemini (vision and overview).
GEMINI_API_KEY=

# Where the Video-MME test videos live. Defaults to ~/data/video-mme.
# VIDEO_MME_DIR=~/data/video-mme
